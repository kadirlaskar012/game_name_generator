{
	"version": 3,
	"routes": [
		{
			"src": "^/_astro/(.*)$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"handle": "filesystem"
		},
		{
			"src": "^\\/_image\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/404\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/500\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/admin\\/login\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/admin\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/amp\\/([^/]+?)-name-generator\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/api\\/admin\\/auth\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/api\\/admin\\/faqs\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/api\\/admin\\/games\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/api\\/admin\\/seo\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/api\\/admin\\/settings\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/api\\/admin\\/styles\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/api\\/admin\\/symbols\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/api\\/favorites\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/api\\/generate\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/api\\/search\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/api\\/track\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/api\\/trending\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/clan-name-generator\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/esports-name-generator\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/favorites\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/games\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/robots\\.txt\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/search\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/sitemap\\.xml\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/trending\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/([^/]+?)-names\\/([^/]+?)\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/([^/]+?)-name-generator\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/$",
			"dest": "_render"
		},
		{
			"src": "/.*",
			"dest": "_render",
			"status": 404
		}
	]
}