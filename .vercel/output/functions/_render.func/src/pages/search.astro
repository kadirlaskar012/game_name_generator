---
import Layout from '@/layouts/Layout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { searchDatabase } from '@/lib/database/repository';

const query = Astro.url.searchParams.get('q') || '';
const results = query ? await searchDatabase(query) : { games: [], styles: [], seoPages: [], names: [] };

const title = query ? `Search Results for "${query}" | GamerTag Pro` : 'Search Gaming Names & Styles';
const description = `Search results for gaming names, styles, fonts, and game-specific generators on GamerTag Pro.`;
const breadcrumbs = [{ name: 'Search', url: '/search/' }];
---

<Layout
  title={title}
  description={description}
  robots="noindex, follow"
>
  <Breadcrumbs items={breadcrumbs} />

  <div class="max-w-4xl mx-auto py-6">
    <h1 class="text-2xl sm:text-3xl font-bold text-white font-gaming mb-6">
      Search Results {query && <span class="text-gaming-accent">"{query}"</span>}
    </h1>

    <form method="GET" action="/search" class="mb-8 flex gap-2">
      <input
        type="text"
        name="q"
        value={query}
        placeholder="Search games, styles, keywords..."
        class="flex-1 px-4 py-3 bg-gaming-darker border border-gaming-border focus:border-gaming-accent rounded-xl text-white outline-none"
      />
      <button
        type="submit"
        class="px-6 py-3 bg-gaming-accent text-black font-bold text-sm rounded-xl shadow-neon-cyan hover:bg-gaming-neon transition"
      >
        Search
      </button>
    </form>

    <div class="space-y-6">
      {results.games.length > 0 && (
        <div class="bg-gaming-card border border-gaming-border rounded-2xl p-5">
          <h2 class="text-sm font-mono text-gray-400 uppercase mb-3">Matching Games ({results.games.length})</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            {results.games.map((g) => (
              <a href={g.slug} class="p-3 bg-gaming-darker hover:bg-white/5 border border-gaming-border rounded-xl flex items-center gap-3 transition">
                <span class="text-2xl">{g.icon}</span>
                <div>
                  <div class="text-sm font-bold text-white font-gaming">{g.title}</div>
                  <div class="text-xs text-gray-400 line-clamp-1">{g.description}</div>
                </div>
              </a>
            ))}
          </div>
        </div>
      )}

      {results.names.length > 0 && (
        <div class="bg-gaming-card border border-gaming-border rounded-2xl p-5">
          <h2 class="text-sm font-mono text-gray-400 uppercase mb-3">Matching Popular Names</h2>
          <div class="flex flex-wrap gap-2">
            {results.names.map((n) => (
              <a href={n.slug} class="px-3 py-1.5 bg-gaming-darker border border-gaming-border hover:border-gaming-flame text-white font-gaming rounded-lg transition">
                {n.title}
              </a>
            ))}
          </div>
        </div>
      )}

      {query && results.games.length === 0 && results.styles.length === 0 && results.names.length === 0 && (
        <div class="text-center py-12 bg-gaming-card border border-dashed border-gaming-border rounded-2xl">
          <p class="text-gray-400 text-sm">No results found for "{query}". Try a different keyword or browse our games directory.</p>
        </div>
      )}
    </div>
  </div>
</Layout>
