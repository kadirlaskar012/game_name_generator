---
import SeoHead from '@/components/SeoHead.astro';
import { AdminAuth } from '@/islands/AdminAuth';
import { validateAdminSession } from '@/lib/security/auth';
import '@/styles/global.css';

const auth = await validateAdminSession(Astro.request);
if (auth.isAuthenticated) {
  return Astro.redirect('/admin/');
}
---

<!doctype html>
<html lang="en" class="dark">
  <SeoHead
    title="Admin Login | GamerTag Pro"
    description="Sign in to platform control center"
    robots="noindex, nofollow"
  />
  <body class="bg-gaming-darker text-gray-100 min-h-screen flex items-center justify-center p-4 antialiased selection:bg-gaming-accent selection:text-black">
    <div class="fixed inset-0 pointer-events-none z-[-1] cyber-grid opacity-50" />
    <AdminAuth client:load />
  </body>
</html>
