---
import SeoHead from '@/components/SeoHead.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import '@/styles/global.css';

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  ogType?: string;
  robots?: string;
  schemaJson?: Record<string, any> | Record<string, any>[];
}

const props = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
  <SeoHead {...props} />
  <body class="bg-white dark:bg-[#0b0f19] text-neutral-900 dark:text-neutral-100 min-h-screen flex flex-col antialiased">
    <Header />

    <main class="flex-1 w-full max-w-5xl mx-auto px-4 sm:px-6 py-6 sm:py-8">
      <slot />
    </main>

    <Footer />
  </body>
</html>
