---
import SeoHead from '@/components/SeoHead.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import '@/styles/global.css';

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  ogType?: string;
  robots?: string;
  schemaJson?: Record<string, any> | Record<string, any>[];
}

const props = Astro.props;
---

<doctype html>
<html lang="en" class="dark">
  <SeoHead {...props} />
  <body class="bg-[#f8fafc] dark:bg-[#07090e] text-neutral-900 dark:text-neutral-100 min-h-screen flex flex-col antialiased selection:bg-sky-500 selection:text-white transition-colors relative">
    <!-- Ambient Radial Mesh Glow Orbs -->
    <div class="fixed inset-0 pointer-events-none z-[-1] mesh-bg opacity-80" />
    <div class="fixed top-[-100px] left-1/2 -translate-x-1/2 w-[600px] h-[350px] bg-gradient-to-b from-sky-500/15 via-indigo-500/10 to-transparent blur-[90px] rounded-full pointer-events-none z-[-1]" />

    <Header />

    <main class="flex-1 w-full max-w-6xl mx-auto px-3.5 sm:px-6 py-6 sm:py-10">
      <slot />
    </main>

    <Footer />
  </body>
</html>
