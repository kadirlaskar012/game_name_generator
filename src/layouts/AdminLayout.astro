---
import SeoHead from '@/components/SeoHead.astro';
import '@/styles/global.css';

export interface Props {
  title?: string;
}

const { title = 'Platform Control Center' } = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
  <SeoHead
    title={`${title} | Admin`}
    description="GamerTag Pro Platform Admin Control Center"
    robots="noindex, nofollow"
  />
  <body class="bg-gaming-darker text-gray-100 min-h-screen antialiased selection:bg-gaming-accent selection:text-black">
    <div class="fixed inset-0 pointer-events-none z-[-1] cyber-grid opacity-40" />

    <!-- Admin Navigation Top Bar -->
    <header class="border-b border-gaming-border bg-gaming-darker/90 backdrop-blur-md px-6 py-4 flex items-center justify-between sticky top-0 z-40">
      <a href="/" class="flex items-center gap-2 group">
        <div class="w-8 h-8 rounded-lg bg-gaming-accent flex items-center justify-center font-display font-bold text-black shadow-neon-cyan">
          G
        </div>
        <span class="font-display font-extrabold text-white text-base">
          GAMERTAG<span class="text-gaming-accent">PRO</span>
        </span>
        <span class="ml-2 px-2 py-0.5 rounded bg-white/10 text-[10px] font-mono text-gray-300">
          ADMIN
        </span>
      </a>

      <div class="flex items-center gap-3 text-xs font-mono">
        <a href="/" class="text-gray-400 hover:text-white transition">
          ← Back to Website
        </a>
      </div>
    </header>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <slot />
    </main>
  </body>
</html>
