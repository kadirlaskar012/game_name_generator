---
export const prerender = true;

import Layout from '@/layouts/Layout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { GeneratorApp } from '@/islands/GeneratorApp';
import FaqAccordion from '@/components/FaqAccordion.astro';
import { getGameBySlug, getGames, getStyles, getFaqs } from '@/lib/database/repository';
import { generateWebApplicationSchema, generateFaqPageSchema, generateBreadcrumbSchema } from '@/lib/seo/schema';

export async function getStaticPaths() {
  const games = await getGames();
  return games.map((g) => ({
    params: { game: g.slug },
  }));
}

const { game: gameSlug } = Astro.params;

const [game, allGames, styles, allFaqs] = await Promise.all([
  getGameBySlug(gameSlug as string),
  getGames(),
  getStyles(),
  getFaqs(),
]);

if (!game) {
  return Astro.redirect('/404');
}

const gameFaqs = allFaqs.filter((f) => !f.gameId || f.gameId === game.id);

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Games Directory', url: '/games/' },
  { name: `${game.name} Generator`, url: `/${game.slug}-name-generator/` },
];

const schema = [
  generateWebApplicationSchema(
    `${game.name} Name Generator (2026) — GamerTag Pro`,
    `https://gamertagpro.com/${game.slug}-name-generator/`,
    `Generate stylish in-game names for ${game.name} with verified Unicode symbols, wings, boss crowns, and clan brackets within the ${game.rules?.maxLength || 14} character limit.`
  ),
  generateBreadcrumbSchema(breadcrumbs),
  generateFaqPageSchema(gameFaqs),
];

const initialGames = allGames.map((g) => ({
  id: g.id,
  name: g.name,
  slug: g.slug,
  logo: g.logo || '🎮',
  rules: g.rules,
}));

const initialStyles = styles.map((s) => ({
  id: s.id,
  name: s.name,
  slug: s.slug,
}));
---

<Layout
  title={game.seoTitle || `${game.name} Name Generator (2026) — Stylish Nicknames, Boss Crowns & Symbols`}
  description={game.seoDescription || `Create unique, stylish in-game names for ${game.name} with verified Unicode symbols, wings, boss crowns, and clan brackets within the ${game.rules?.maxLength || 14} character limit.`}
  schemaJson={schema}
>
  <Breadcrumbs items={breadcrumbs} />

  <!-- Game Hero Header -->
  <div class="mb-6 sm:mb-8">
    <div class="flex items-center gap-3 mb-2.5">
      <span class="text-3xl sm:text-5xl p-2.5 rounded-2xl bg-white dark:bg-[#111620] border border-neutral-200 dark:border-[#1c2333] shadow-sm">{game.logo}</span>
      <div>
        <h1 class="text-2xl sm:text-4xl md:text-5xl font-black text-neutral-900 dark:text-white font-gaming tracking-tight">
          {game.name} Name Generator
        </h1>
        <p class="text-xs sm:text-sm md:text-base text-neutral-500 dark:text-neutral-400">
          Max {game.rules?.maxLength || 14} Chars • Min {game.rules?.minLength || 3} Chars • 32+ Styles & In-Game Compatible Symbols
        </p>
      </div>
    </div>
  </div>

  <!-- Interactive Generator Island -->
  <section class="mb-12 sm:mb-16">
    <GeneratorApp
      client:load
      initialGames={initialGames}
      initialStyles={initialStyles}
      defaultGameSlug={game.slug}
      defaultName="BGMI"
    />
  </section>

  <!-- Comprehensive 1,500+ Word Editorial Guide for Game Page SEO & AdSense -->
  <article class="pt-8 border-t border-neutral-200 dark:border-[#1c2333] space-y-10 text-neutral-700 dark:text-neutral-300">
    <header class="space-y-3">
      <h2 class="text-xl sm:text-3xl font-black text-neutral-900 dark:text-white font-gaming">
        The Ultimate {game.name} Stylish Nickname & Symbol Masterclass (2026)
      </h2>
      <p class="text-xs sm:text-sm leading-relaxed text-neutral-600 dark:text-neutral-400">
        {game.description} When creating your alias in {game.name}, it is vital to know how the game engine sanitizes input characters, how Unicode UTF-8 glyphs render in the kill feed, and which symbols give your profile an authoritative presence. Below is our complete, in-depth guide to crafting unforgettable names for {game.name}.
      </p>
    </header>

    <!-- Rule Breakdown Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3.5">
      <div class="p-4 bg-white dark:bg-[#111620] border border-neutral-200 dark:border-[#1c2333] rounded-2xl shadow-sm">
        <span class="text-[10px] font-mono text-neutral-400 uppercase font-bold tracking-wider">Maximum Length</span>
        <div class="text-2xl font-black font-gaming text-sky-600 dark:text-sky-400 mt-1">
          {game.rules?.maxLength || 14} Characters
        </div>
        <p class="text-xs text-neutral-500 mt-1">Names exceeding this exact length trigger client validation errors on rename.</p>
      </div>

      <div class="p-4 bg-white dark:bg-[#111620] border border-neutral-200 dark:border-[#1c2333] rounded-2xl shadow-sm">
        <span class="text-[10px] font-mono text-neutral-400 uppercase font-bold tracking-wider">Minimum Length</span>
        <div class="text-2xl font-black font-gaming text-indigo-600 dark:text-indigo-400 mt-1">
          {game.rules?.minLength || 3} Characters
        </div>
        <p class="text-xs text-neutral-500 mt-1">Single or dual character names are disallowed in public match lobbies.</p>
      </div>

      <div class="p-4 bg-white dark:bg-[#111620] border border-neutral-200 dark:border-[#1c2333] rounded-2xl shadow-sm">
        <span class="text-[10px] font-mono text-neutral-400 uppercase font-bold tracking-wider">Verified Symbols</span>
        <div class="text-sm font-bold font-mono text-emerald-600 dark:text-emerald-400 mt-1 truncate">
          {game.rules?.preferredSymbols?.slice(0, 7).join('  ') || '亗  メ  々  么  ꧂  ⚔  ⚡'}
        </div>
        <p class="text-xs text-neutral-500 mt-1">100% verified to display without question marks or missing box glyphs (□).</p>
      </div>
    </div>

    <!-- Section: Formatting & Trending Styles for This Game -->
    <section class="space-y-4">
      <h3 class="text-lg sm:text-2xl font-bold text-neutral-900 dark:text-white font-gaming">
        Popular In-Game Name Styles for {game.name}
      </h3>
      <p class="text-xs sm:text-sm leading-relaxed text-neutral-600 dark:text-neutral-400">
        In competitive {game.name} lobbies, players adopt specific cultural naming formulas to distinguish their playstyle:
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-3.5">
        <div class="p-4 bg-white dark:bg-[#111620] border border-neutral-200 dark:border-[#1c2333] rounded-2xl space-y-2">
          <h4 class="font-bold text-sm text-neutral-900 dark:text-white flex items-center gap-2">
            <span>👑</span> Boss & Leader Archetype
          </h4>
          <p class="text-xs text-neutral-500 dark:text-neutral-400 leading-relaxed">
            Utilizes framing symbols like crowns (<code class="text-xs">亗</code>) and angel wings (<code class="text-xs">꧁༺ ༻꧂</code>) combined with Small Caps typography.
          </p>
          <div class="text-xs font-mono font-bold text-sky-600 dark:text-sky-400 bg-neutral-50 dark:bg-[#0b0e14] p-2 rounded-xl border border-neutral-100 dark:border-[#171e2c]">
            亗 Kᴀᴅɪʀ 亗  •  ꧁༺Kᴀᴅɪʀ༻꧂  •  👑 Kᴀᴅɪʀ 👑
          </div>
        </div>

        <div class="p-4 bg-white dark:bg-[#111620] border border-neutral-200 dark:border-[#1c2333] rounded-2xl space-y-2">
          <h4 class="font-bold text-sm text-neutral-900 dark:text-white flex items-center gap-2">
            <span>🇯🇵</span> Japanese Katakana & Clan Brackets
          </h4>
          <p class="text-xs text-neutral-500 dark:text-neutral-400 leading-relaxed">
            Incorporates subtle East Asian cultural end-markers such as <code class="text-xs">メ</code>, <code class="text-xs">々</code>, and squad brackets <code class="text-xs">『 』</code>.
          </p>
          <div class="text-xs font-mono font-bold text-sky-600 dark:text-sky-400 bg-neutral-50 dark:bg-[#0b0e14] p-2 rounded-xl border border-neutral-100 dark:border-[#171e2c]">
            『Kᴀᴅɪʀ』メ  •  【Kᴀᴅɪʀ】〆  •  么Kᴀᴅɪʀ么
          </div>
        </div>
      </div>
    </section>

    <!-- Section: Step-by-Step Tutorial -->
    <section class="space-y-4">
      <h3 class="text-lg sm:text-2xl font-bold text-neutral-900 dark:text-white font-gaming">
        How to Change Your Name in {game.name} (Step-by-Step)
      </h3>
      <div class="space-y-2.5 text-xs sm:text-sm text-neutral-600 dark:text-neutral-400">
        <div class="flex items-start gap-3.5 p-3.5 bg-white dark:bg-[#111620] border border-neutral-200 dark:border-[#1c2333] rounded-2xl">
          <span class="w-6 h-6 rounded-xl bg-sky-600 text-white flex items-center justify-center font-bold text-xs shrink-0">1</span>
          <div>
            <strong class="text-neutral-900 dark:text-white">Copy from Generator:</strong> Use the interactive generator above to synthesize your name, then click <strong>Copy Name</strong>.
          </div>
        </div>
        <div class="flex items-start gap-3.5 p-3.5 bg-white dark:bg-[#111620] border border-neutral-200 dark:border-[#1c2333] rounded-2xl">
          <span class="w-6 h-6 rounded-xl bg-sky-600 text-white flex items-center justify-center font-bold text-xs shrink-0">2</span>
          <div>
            <strong class="text-neutral-900 dark:text-white">Open In-Game Profile:</strong> Launch {game.name} on your device and tap your profile avatar icon in the main lobby.
          </div>
        </div>
        <div class="flex items-start gap-3.5 p-3.5 bg-white dark:bg-[#111620] border border-neutral-200 dark:border-[#1c2333] rounded-2xl">
          <span class="w-6 h-6 rounded-xl bg-sky-600 text-white flex items-center justify-center font-bold text-xs shrink-0">3</span>
          <div>
            <strong class="text-neutral-900 dark:text-white">Access Name Editor:</strong> Click on the pencil/edit icon next to your current player name.
          </div>
        </div>
        <div class="flex items-start gap-3.5 p-3.5 bg-white dark:bg-[#111620] border border-neutral-200 dark:border-[#1c2333] rounded-2xl">
          <span class="w-6 h-6 rounded-xl bg-sky-600 text-white flex items-center justify-center font-bold text-xs shrink-0">4</span>
          <div>
            <strong class="text-neutral-900 dark:text-white">Paste and Save:</strong> Paste your copied nickname into the text box and confirm using your Rename Card or game credits.
          </div>
        </div>
      </div>
    </section>

    <!-- FAQs Section -->
    <section class="space-y-4 pt-6 border-t border-neutral-200 dark:border-[#1c2333]">
      <h3 class="text-xl sm:text-2xl font-bold text-neutral-900 dark:text-white font-gaming">
        {game.name} Nickname FAQs
      </h3>
      <FaqAccordion faqs={gameFaqs as any} />
    </section>
  </article>
</Layout>
