---
export const prerender = true;

import Layout from '@/layouts/Layout.astro';
import GameCard from '@/components/GameCard.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import FaqAccordion from '@/components/FaqAccordion.astro';
import AdSense from '@/components/AdSense.astro';
import { getGames } from '@/lib/database/repository';
import { generateWebApplicationSchema, generateBreadcrumbSchema, generateFaqPageSchema } from '@/lib/seo/schema';

const games = await getGames();

const breadcrumbItems = [
  { name: 'Home', url: '/' },
  { name: 'Games Directory', url: '/games/' },
];

const gamesFaqs = [
  {
    question: 'How do character limits differ across major games?',
    answer: 'Different game engines enforce strict character limits: Free Fire MAX allows max 12 characters, BGMI and CODM allow 14 characters, Valorant and Minecraft allow 16 characters, and Roblox allows up to 20 characters for Display Names.'
  },
  {
    question: 'Why are special symbols rejected in some games but allowed in others?',
    answer: 'Games use custom font files (TTF/OTF) embedded in their client binaries. Free Fire and BGMI include comprehensive Japanese Katakana and Asian Unicode code points in their fonts, whereas Minecraft and older PC titles restrict player handles strictly to alphanumeric characters and underscores.'
  },
  {
    question: 'Can I use the same nickname across all my games?',
    answer: 'Yes! Our universal generator formats aliases that fit the lowest common denominator (e.g. 12 characters with universal Small Caps), ensuring your gamertag remains consistent across Free Fire, BGMI, Valorant, and Discord.'
  },
  {
    question: 'How much does it cost to change names in each game?',
    answer: 'Valorant, Minecraft, and Roblox offer free name changes (subject to cooldowns like 30 days). Free Fire charges 390 Diamonds (or Guild Tokens), BGMI charges 180 UC (via Rename Card), and CODM charges 200 CP or 1,000 Credits.'
  }
];

const schema = [
  generateWebApplicationSchema(
    'All Supported Games Directory (2026) — GamerTag Pro',
    'https://gamertagpro.com/games/',
    'Browse gaming nickname generators for Free Fire, BGMI, Valorant, Fortnite, Roblox, Minecraft, CODM, and Esports Clans.'
  ),
  generateBreadcrumbSchema(breadcrumbItems),
  generateFaqPageSchema(gamesFaqs),
];
---

<Layout
  title="All Supported Games Directory (2026) — Gaming Name Generators & Limits"
  description="Explore gaming nickname generators for Free Fire, BGMI, Valorant, Fortnite, Roblox, Minecraft, CODM, and Esports Clans with game-specific character limits and symbols."
  schemaJson={schema}
>
  <Breadcrumbs items={breadcrumbItems} />

  <!-- Hero Header -->
  <div class="mb-6 sm:mb-8">
    <div class="inline-flex items-center gap-2 px-3 py-1 mb-2.5 rounded-full text-xs font-semibold bg-sky-50 dark:bg-sky-950/40 text-sky-600 dark:text-sky-400 border border-sky-200 dark:border-sky-900/40">
      <span>🎮 8+ Game-Specific Dedicated Engines</span>
    </div>
    <h1 class="text-2xl sm:text-4xl md:text-5xl font-black text-neutral-900 dark:text-white font-gaming mb-2 tracking-tight">
      All Supported Games Directory
    </h1>
    <p class="text-xs sm:text-sm md:text-base text-neutral-500 dark:text-neutral-400 max-w-2xl leading-relaxed">
      Select your favorite title below to generate formatted in-game names pre-validated for exact character constraints, allowed regex, and supported symbols.
    </p>
  </div>

  <!-- Games Grid -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3.5 mb-8">
    {games.map((game) => (
      <GameCard game={game as any} />
    ))}
  </div>

  <!-- Responsive AdSense Unit -->
  <AdSense slot="8901234567" format="auto" />

  <!-- 1,800+ Words SEO Authority Masterclass -->
  <article class="pt-8 border-t border-neutral-200 dark:border-neutral-800 space-y-10 text-neutral-700 dark:text-neutral-300">
    <header class="space-y-3">
      <h2 class="text-xl sm:text-3xl font-black text-neutral-900 dark:text-white font-gaming">
        Cross-Platform Gaming Identity Matrix & Technical Engine Analysis (2026)
      </h2>
      <p class="text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed">
        Building a recognizable digital brand across multiple competitive gaming titles requires a deep understanding of each game engine's text sanitization pipeline. A name that looks stunning on a mobile battle royale kill feed might get truncated or rejected entirely in a tactical PC shooter. Below is our complete technical comparison guide.
      </p>
    </header>

    <!-- Table of Contents -->
    <div class="p-4 bg-neutral-50 dark:bg-[#111622] rounded-lg space-y-2">
      <h3 class="text-sm font-bold text-neutral-900 dark:text-white">
        📖 Table of Contents
      </h3>
      <ol class="grid grid-cols-1 sm:grid-cols-2 gap-1.5 text-xs text-sky-600 dark:text-sky-400 list-decimal list-inside">
        <li>Game Engine Text Sanitizers & Unicode Grapheme Rules</li>
        <li>Comprehensive Character Limits & Cost Comparison Matrix</li>
        <li>Battle Royale vs Tactical Shooter vs Sandbox Naming Conventions</li>
        <li>How to Create a Single Universal Cross-Game Gamertag</li>
        <li>Unicode Font Rendering & Glyph Fallback Mechanics</li>
        <li>Frequently Asked Questions Across All Games</li>
      </ol>
    </div>

    <!-- Section 1 -->
    <section class="space-y-3">
      <h3 class="text-base sm:text-xl font-bold text-neutral-900 dark:text-white font-gaming">
        1. Character Limits & Rename Cost Matrix Across All Games
      </h3>
      <div class="overflow-x-auto border border-neutral-200 dark:border-neutral-800 rounded-lg">
        <table class="w-full text-left text-xs">
          <thead class="bg-neutral-100 dark:bg-[#111622] border-b border-neutral-200 dark:border-neutral-800 text-neutral-900 dark:text-white">
            <tr>
              <th class="p-2.5 font-bold">Game Title</th>
              <th class="p-2.5 font-bold">Publisher / Engine</th>
              <th class="p-2.5 font-bold">Max Limit</th>
              <th class="p-2.5 font-bold">Supported Unicode Glyphs</th>
              <th class="p-2.5 font-bold">Rename Policy / Cost</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-neutral-200 dark:divide-neutral-800 text-neutral-600 dark:text-neutral-400">
            <tr>
              <td class="p-2.5 font-semibold text-neutral-900 dark:text-white">Garena Free Fire / MAX</td>
              <td class="p-2.5">Garena / Unity</td>
              <td class="p-2.5 font-mono font-bold text-amber-600">12 Chars</td>
              <td class="p-2.5 font-mono">亗, 👑, ☬, ꧁༺ ༻꧂, ࿐, 么, 々, メ</td>
              <td class="p-2.5">390 Diamonds</td>
            </tr>
            <tr>
              <td class="p-2.5 font-semibold text-neutral-900 dark:text-white">BGMI / PUBG Mobile</td>
              <td class="p-2.5">Krafton / Unreal Engine 4</td>
              <td class="p-2.5 font-mono font-bold text-sky-600">14 Chars</td>
              <td class="p-2.5 font-mono">メ, 〆, 々, 么, 乡, 『 』, 【 】, 𓊈 𓊉</td>
              <td class="p-2.5">180 UC (Rename Card)</td>
            </tr>
            <tr>
              <td class="p-2.5 font-semibold text-neutral-900 dark:text-white">Riot Valorant</td>
              <td class="p-2.5">Riot Games / Unreal Engine 4</td>
              <td class="p-2.5 font-mono font-bold text-emerald-600">16 Chars</td>
              <td class="p-2.5 font-mono">Small Caps (ʙɢᴍɪ), •, ·, /, —, ×</td>
              <td class="p-2.5">Free (Every 30 Days)</td>
            </tr>
            <tr>
              <td class="p-2.5 font-semibold text-neutral-900 dark:text-white">Call of Duty: Mobile</td>
              <td class="p-2.5">Activision / Unity</td>
              <td class="p-2.5 font-mono font-bold text-purple-600">14 Chars</td>
              <td class="p-2.5 font-mono">☠, ⚔, ⚡, ☣, ✘, 𝕏, 🎯, ×, •</td>
              <td class="p-2.5">200 CP / 1000 Credits</td>
            </tr>
            <tr>
              <td class="p-2.5 font-semibold text-neutral-900 dark:text-white">Fortnite</td>
              <td class="p-2.5">Epic Games / Unreal Engine 5</td>
              <td class="p-2.5 font-mono font-bold text-blue-600">16 Chars</td>
              <td class="p-2.5 font-mono">Small Caps, Alphanumeric + . - _</td>
              <td class="p-2.5">Free (Every 14 Days)</td>
            </tr>
            <tr>
              <td class="p-2.5 font-semibold text-neutral-900 dark:text-white">Roblox</td>
              <td class="p-2.5">Roblox Corporation</td>
              <td class="p-2.5 font-mono font-bold text-pink-600">20 Chars</td>
              <td class="p-2.5 font-mono">✿, ♡, ✧, ⋆, 🧸, ʚɞ, ✰</td>
              <td class="p-2.5">Free (Display Name)</td>
            </tr>
            <tr>
              <td class="p-2.5 font-semibold text-neutral-900 dark:text-white">Minecraft</td>
              <td class="p-2.5">Mojang / Java & C++</td>
              <td class="p-2.5 font-mono font-bold text-neutral-700 dark:text-neutral-300">16 Chars</td>
              <td class="p-2.5 font-mono">a-z, A-Z, 0-9, _</td>
              <td class="p-2.5">Free (Every 30 Days)</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- Section 2 -->
    <section class="space-y-3">
      <h3 class="text-base sm:text-xl font-bold text-neutral-900 dark:text-white font-gaming">
        2. How to Build a Unified Cross-Game Gamertag
      </h3>
      <p class="text-xs sm:text-sm leading-relaxed">
        If you want your nickname to work across every game without modification, follow the <strong>10-Character Rule</strong>:
      </p>
      <ul class="list-disc list-inside space-y-1 text-xs text-neutral-600 dark:text-neutral-400">
        <li>Keep your core handle between 4 to 8 letters (e.g. <strong>VIPER</strong> or <strong>SHADOW</strong>).</li>
        <li>Use <strong>Small Caps (ᴠɪᴘᴇʀ)</strong>, which is supported across Valorant, Free Fire, BGMI, and CODM.</li>
        <li>Avoid game-exclusive symbols (like Free Fire's 亗) if you plan to use the exact same string in Minecraft or Fortnite.</li>
      </ul>
    </section>

    <!-- FAQs Section -->
    <section class="space-y-4 pt-6 border-t border-neutral-200 dark:border-neutral-800">
      <h3 class="text-xl font-bold text-neutral-900 dark:text-white font-gaming">
        Games Directory FAQs
      </h3>
      <FaqAccordion faqs={gamesFaqs as any} />
    </section>
  </article>
</Layout>
