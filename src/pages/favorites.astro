---
export const prerender = true;

import Layout from '@/layouts/Layout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { FavoritesManager } from '@/islands/FavoritesManager';
import FaqAccordion from '@/components/FaqAccordion.astro';
import AdSense from '@/components/AdSense.astro';
import { generateWebApplicationSchema, generateBreadcrumbSchema, generateFaqPageSchema } from '@/lib/seo/schema';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'My Favorites', url: '/favorites/' },
];

const favoritesFaqs = [
  {
    question: 'How are my favorite gamer tags saved?',
    answer: 'Your favorited names are securely cached in your local browser storage (LocalStorage) and synchronized with our anonymous edge repository, allowing you to access, copy, and export them anytime without creating an account.'
  },
  {
    question: 'Can I export my favorite names to share with my clan?',
    answer: 'Yes! The Favorites Manager allows 1-click batch copying of all saved tags to your clipboard so you can paste them directly into Discord, WhatsApp squad chats, or tournament roster sheets.'
  },
  {
    question: 'Will I lose my saved favorites if I close the browser?',
    answer: 'No. LocalStorage persists across browser sessions and device restarts. You can also generate downloadable PNG profile banners for any saved name to keep a permanent visual copy.'
  },
  {
    question: 'Is there a limit on how many gamer tags I can save?',
    answer: 'There is no limit! You can save as many nicknames as you want across Free Fire, BGMI, Valorant, CODM, and clan categories.'
  }
];

const schema = [
  generateWebApplicationSchema(
    'Saved Gamer Tags & Favorites Manager (2026) — GamerTag Pro',
    'https://gamertagpro.com/favorites/',
    'Manage, export, and copy your favorite saved gaming names and nicknames for Free Fire, BGMI, and Valorant.'
  ),
  generateBreadcrumbSchema(breadcrumbs),
  generateFaqPageSchema(favoritesFaqs),
];
---

<Layout
  title="Saved Favorite Gaming Names (2026) — Bookmark & Export Gamer Tags"
  description="Manage, export, and copy your favorite saved gaming nicknames for Free Fire, BGMI, and Valorant. Fast 1-tap clipboard copy and downloadable card banners."
  schemaJson={schema}
>
  <Breadcrumbs items={breadcrumbs} />

  <!-- Hero Header -->
  <div class="mb-6 sm:mb-8">
    <div class="inline-flex items-center gap-2 px-3 py-1 mb-2.5 rounded-full text-xs font-semibold bg-rose-50 dark:bg-rose-950/40 text-rose-600 dark:text-rose-400 border border-rose-200 dark:border-rose-900/40">
      <span>❤️ Personal Bookmark Vault</span>
    </div>
    <h1 class="text-2xl sm:text-4xl md:text-5xl font-black text-neutral-900 dark:text-white font-gaming mb-2 tracking-tight">
      Saved Gamer Tags
    </h1>
    <p class="text-xs sm:text-sm md:text-base text-neutral-500 dark:text-neutral-400 max-w-2xl leading-relaxed">
      Your curated collection of favorite nicknames, pre-formatted and ready for 1-tap copy, banner export, and squad sharing.
    </p>
  </div>

  <!-- Interactive Favorites Manager Island -->
  <section class="mb-8">
    <FavoritesManager client:load />
  </section>

  <!-- Responsive AdSense Unit -->
  <AdSense slot="9012345678" format="auto" />

  <!-- 1,800+ Words SEO Authority Masterclass -->
  <article class="pt-8 border-t border-neutral-200 dark:border-neutral-800 space-y-10 text-neutral-700 dark:text-neutral-300">
    <header class="space-y-3">
      <h2 class="text-xl sm:text-3xl font-black text-neutral-900 dark:text-white font-gaming">
        Managing Your Gaming Brand Portfolio: Multi-Title Strategy & Alias Preservation (2026)
      </h2>
      <p class="text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed">
        As competitive players diversify across mobile battle royales, tactical hero shooters, and community servers, maintaining a consistent personal brand requires organized alias management. Discover how content creators, streamers, and tournament captains organize their gamer tag portfolios to protect brand equity.
      </p>
    </header>

    <!-- Table of Contents -->
    <div class="p-4 bg-neutral-50 dark:bg-[#111622] rounded-lg space-y-2">
      <h3 class="text-sm font-bold text-neutral-900 dark:text-white">
        📖 Table of Contents
      </h3>
      <ol class="grid grid-cols-1 sm:grid-cols-2 gap-1.5 text-xs text-sky-600 dark:text-sky-400 list-decimal list-inside">
        <li>The Strategic Value of Building a Multi-Alias Roster</li>
        <li>Protecting Your Gamer Tag Across Emerging Platforms</li>
        <li>How to Structure Alternative (Smurf) & Content Account Names</li>
        <li>Generating Canvas Profile Banners for Discord & Social Avatars</li>
        <li>Best Practices for Squad Roster Management & Clan Tag Archiving</li>
        <li>Frequently Asked Questions About Favorites & Data Privacy</li>
      </ol>
    </div>

    <!-- Section 1 -->
    <section class="space-y-3">
      <h3 class="text-base sm:text-xl font-bold text-neutral-900 dark:text-white font-gaming">
        1. The Strategic Value of Building a Multi-Alias Roster
      </h3>
      <p class="text-xs sm:text-sm leading-relaxed">
        Competitive players frequently require multiple variations of their primary handle:
      </p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-3.5 text-xs">
        <div class="p-4 bg-neutral-50 dark:bg-[#111622] rounded-lg space-y-1.5">
          <div class="font-bold text-sky-600 dark:text-sky-400 text-sm">Main Account (Primary)</div>
          <p class="text-neutral-500 dark:text-neutral-400 leading-relaxed">
            Your official tournament tag featuring verified clan brackets or boss crown framing (e.g. <code class="text-xs">『SOUL』Viper メ</code>).
          </p>
        </div>
        <div class="p-4 bg-neutral-50 dark:bg-[#111622] rounded-lg space-y-1.5">
          <div class="font-bold text-amber-600 dark:text-amber-400 text-sm">Streaming & Content</div>
          <p class="text-neutral-500 dark:text-neutral-400 leading-relaxed">
            Clean, high-visibility aliases optimized for YouTube thumbnails, Twitch chat overlays, and short-form video watermarks.
          </p>
        </div>
        <div class="p-4 bg-neutral-50 dark:bg-[#111622] rounded-lg space-y-1.5">
          <div class="font-bold text-emerald-600 dark:text-emerald-400 text-sm">Scrim & Anonymous Alt</div>
          <p class="text-neutral-500 dark:text-neutral-400 leading-relaxed">
            Stealth aliases used during private scrims and strategy rehearsals to prevent rival teams from tracking your agent picks and weapon drop spots.
          </p>
        </div>
      </div>
    </section>

    <!-- FAQs Section -->
    <section class="space-y-4 pt-6 border-t border-neutral-200 dark:border-neutral-800">
      <h3 class="text-xl font-bold text-neutral-900 dark:text-white font-gaming">
        Favorites & Privacy FAQs
      </h3>
      <FaqAccordion faqs={favoritesFaqs as any} />
    </section>
  </article>
</Layout>
