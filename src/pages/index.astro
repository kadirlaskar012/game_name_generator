---
import Layout from '@/layouts/Layout.astro';
import { GeneratorApp } from '@/islands/GeneratorApp';
import { TrendingSection } from '@/islands/TrendingSection';
import GameCard from '@/components/GameCard.astro';
import FaqAccordion from '@/components/FaqAccordion.astro';
import { getGames, getStyles, getFaqs } from '@/lib/database/repository';
import { generateWebSiteSchema, generateWebApplicationSchema, generateFaqPageSchema } from '@/lib/seo/schema';

const [games, styles, faqs] = await Promise.all([
  getGames(),
  getStyles(),
  getFaqs(),
]);

const initialGames = games.map((g) => ({
  id: g.id,
  name: g.name,
  slug: g.slug,
  logo: g.logo || '🎮',
  rules: g.rules,
}));

const initialStyles = styles.map((s) => ({
  id: s.id,
  name: s.name,
  slug: s.slug,
}));

const homeSchema = [
  generateWebSiteSchema('https://gamertagpro.com', 'GamerTag Pro'),
  generateWebApplicationSchema(
    'GamerTag Pro — Gaming Name & Nickname Generator (2026)',
    'https://gamertagpro.com',
    'Generate stylish, unique, and game-acceptable gaming nicknames for Free Fire, BGMI, Valorant, PUBG Mobile, and Esports Clans with 32+ verified Unicode fonts and symbols.'
  ),
  generateFaqPageSchema(faqs),
];
---

<Layout
  title="Gaming Name Generator (2026) — 100% In-Game Compatible Stylish Nicknames & Symbols"
  description="Generate stylish, unique, and game-acceptable gaming nicknames for Free Fire, BGMI, Valorant, PUBG Mobile, and Esports Clans. Features Small Caps (ᴋᴀᴅɪʀ), boss crowns (亗), angel wings (꧁༺ ༻꧂), and clan brackets."
  schemaJson={homeSchema}
>
  <!-- Hero Section -->
  <section class="text-center pt-3 sm:pt-6 pb-6 sm:pb-8 max-w-3xl mx-auto px-2">
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 mb-3.5 rounded-full text-xs font-semibold bg-sky-50 dark:bg-sky-950/40 text-sky-600 dark:text-sky-400 border border-sky-200 dark:border-sky-900/40 shadow-sm">
      <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
      <span>100% In-Game Acceptable Unicode Engine (32+ Styles)</span>
    </div>

    <h1 class="text-2xl sm:text-4xl md:text-5xl font-black text-neutral-900 dark:text-white font-gaming tracking-tight mb-3">
      Gaming Name Generator
    </h1>
    <p class="text-xs sm:text-sm md:text-base text-neutral-600 dark:text-neutral-400 leading-relaxed max-w-xl mx-auto">
      Create stylish nicknames, boss crowns (<span class="font-mono text-neutral-900 dark:text-white font-bold">亗</span>), Japanese Katakana, and clan tags for Free Fire, BGMI, Valorant, and Esports squads.
    </p>
  </section>

  <!-- Real-Time Interactive Generator Island -->
  <section class="mb-12 sm:mb-16">
    <GeneratorApp
      client:load
      initialGames={initialGames}
      initialStyles={initialStyles}
      defaultGameSlug="free-fire"
      defaultName="Kadir"
    />
  </section>

  <!-- Games Catalogue Section -->
  <section class="mb-12 sm:mb-16">
    <div class="flex items-center justify-between mb-4 sm:mb-5">
      <div>
        <h2 class="text-lg sm:text-2xl font-bold text-neutral-900 dark:text-white font-gaming">
          Game-Specific Generators
        </h2>
        <p class="text-xs text-neutral-500 dark:text-neutral-400">
          Tailored with exact character limits and supported symbols
        </p>
      </div>
      <a
        href="/games/"
        class="text-xs font-bold text-sky-600 dark:text-sky-400 hover:underline transition-colors"
      >
        View All 8 Games →
      </a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4">
      {games.slice(0, 8).map((game) => (
        <GameCard game={game as any} />
      ))}
    </div>
  </section>

  <!-- Live Trending Leaderboard -->
  <section class="mb-12 sm:mb-16">
    <div class="flex items-center justify-between mb-4 sm:mb-5">
      <div>
        <h2 class="text-lg sm:text-2xl font-bold text-neutral-900 dark:text-white font-gaming flex items-center gap-2">
          <span>🔥</span> Trending In-Game Nicknames
        </h2>
        <p class="text-xs text-neutral-500 dark:text-neutral-400">
          Most copied and favorited gamer tags across all games
        </p>
      </div>
      <a
        href="/trending/"
        class="text-xs font-bold text-amber-600 dark:text-amber-400 hover:underline transition-colors"
      >
        Full Leaderboard →
      </a>
    </div>

    <TrendingSection client:visible />
  </section>

  <!-- 1,500+ Word In-Depth SEO & Google AdSense Editorial Guide -->
  <article class="pt-10 border-t border-neutral-200 dark:border-[#1c2333] space-y-12 text-neutral-700 dark:text-neutral-300">
    <header class="space-y-4">
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-black text-neutral-900 dark:text-white font-gaming">
        The Definitive Guide to Gaming Names, Stylish Nicknames & Esports IGNs (2026)
      </h2>
      <p class="text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed">
        Your in-game name (IGN) is your digital identity across the competitive gaming world. Whether you are leading a squad in Garena Free Fire MAX, securing clutch rounds in BGMI (Battlegrounds Mobile India) and PUBG Mobile, clutching on Valorant Radiant leaderboards, or dominating Call of Duty: Mobile, having a stylish, distinctive, and intimidating nickname sets you apart from casual players. This masterclass provides a complete, 1,500+ word deep-dive into gaming nickname psychology, UTF-8 font transformations, in-game byte limits, and pro clan branding.
      </p>
    </header>

    <!-- Table of Contents -->
    <div class="p-5 bg-white dark:bg-[#111620] border border-neutral-200 dark:border-[#1c2333] rounded-2xl shadow-sm space-y-3">
      <h3 class="text-sm sm:text-base font-bold text-neutral-900 dark:text-white font-gaming flex items-center gap-2">
        <span>📖</span> Table of Contents
      </h3>
      <ol class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs font-medium text-sky-600 dark:text-sky-400 list-decimal list-inside pl-1">
        <li>The Psychology Behind Viral Gaming Nicknames</li>
        <li>Character Limits & Encoding Rules Across Top Games</li>
        <li>How Unicode Mathematical Fonts Render in UTF-8</li>
        <li>Cultural Symbols Breakdown: Boss Crowns, Wings & Katakana</li>
        <li>How to Change Your Name In-Game Without Glyph Box (□) Errors</li>
        <li>Esports Squad Tag Formats & Clan Identity Architecture</li>
        <li>Pro Player Case Studies: Mortal, Jonathan, Raistar & TenZ</li>
        <li>Frequently Asked Questions & Nickname Troubleshooting</li>
      </ol>
    </div>

    <!-- Section 1 -->
    <section class="space-y-4">
      <h3 class="text-xl sm:text-2xl font-bold text-neutral-900 dark:text-white font-gaming">
        1. The Psychology Behind Viral Gaming Nicknames
      </h3>
      <p class="text-xs sm:text-sm leading-relaxed">
        A top-tier gaming nickname does far more than label your account—it projects psychological dominance inside the pre-match lobby and the kill feed. When enemies see a symmetrical, carefully styled alias like <strong class="text-neutral-900 dark:text-white font-mono">亗 Kᴀᴅɪʀ 亗</strong> or <strong class="text-neutral-900 dark:text-white font-mono">『Kᴀᴅɪʀ』メ</strong> appear repeatedly on the elimination ticker, it establishes immediate authority and tactical intimidation.
      </p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 pt-2">
        <div class="p-4 bg-white dark:bg-[#111620] border border-neutral-200 dark:border-[#1c2333] rounded-2xl">
          <h4 class="font-bold text-neutral-900 dark:text-white text-sm mb-1.5">1. Comms Clarity</h4>
          <p class="text-xs text-neutral-500 dark:text-neutral-400 leading-relaxed">
            In fast-paced esports, callouts happen in milliseconds. Names between 4 and 8 characters with 1 to 2 syllables allow your In-Game Leader (IGL) and squadmates to communicate effortlessly.
          </p>
        </div>
        <div class="p-4 bg-white dark:bg-[#111620] border border-neutral-200 dark:border-[#1c2333] rounded-2xl">
          <h4 class="font-bold text-neutral-900 dark:text-white text-sm mb-1.5">2. Kill Feed Symmetrical Framing</h4>
          <p class="text-xs text-neutral-500 dark:text-neutral-400 leading-relaxed">
            Framing symbols like wings (<code class="text-xs">꧁༺ ༻꧂</code>), crowns (<code class="text-xs">亗</code>), and brackets (<code class="text-xs">【 】</code>) draw the eye instantly on high-resolution displays.
          </p>
        </div>
        <div class="p-4 bg-white dark:bg-[#111620] border border-neutral-200 dark:border-[#1c2333] rounded-2xl">
          <h4 class="font-bold text-neutral-900 dark:text-white text-sm mb-1.5">3. Multi-Platform Brand Scalability</h4>
          <p class="text-xs text-neutral-500 dark:text-neutral-400 leading-relaxed">
            A great alias transitions seamlessly from your mobile game to YouTube Gaming channels, Discord servers, Twitch streams, and tournament rosters.
          </p>
        </div>
      </div>
    </section>

    <!-- Section 2 -->
    <section class="space-y-4">
      <h3 class="text-xl sm:text-2xl font-bold text-neutral-900 dark:text-white font-gaming">
        2. In-Game Character Limits & Encoding Rules Across Top Games (2026)
      </h3>
      <p class="text-xs sm:text-sm leading-relaxed">
        Game engines process player names through different text sanitizers. Some games count raw bytes (where multi-byte Unicode characters consume 3 bytes), while others count Unicode code points (where each glyph counts as 1 character). Exceeding these limits causes the game client to reject the Rename Card.
      </p>

      <div class="overflow-x-auto border border-neutral-200 dark:border-[#1c2333] rounded-2xl bg-white dark:bg-[#111620] shadow-sm">
        <table class="w-full text-left text-xs">
          <thead class="bg-neutral-100 dark:bg-[#0b0e14] border-b border-neutral-200 dark:border-[#1c2333] text-neutral-900 dark:text-white">
            <tr>
              <th class="p-3.5 font-bold">Game Title</th>
              <th class="p-3.5 font-bold">Max Limit</th>
              <th class="p-3.5 font-bold">Min Limit</th>
              <th class="p-3.5 font-bold">Supported Unicode Symbols</th>
              <th class="p-3.5 font-bold">Rename Cost</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-neutral-100 dark:divide-[#1c2333] text-neutral-600 dark:text-neutral-400">
            <tr>
              <td class="p-3.5 font-semibold text-neutral-900 dark:text-white">Garena Free Fire / MAX</td>
              <td class="p-3.5 font-mono font-bold text-amber-600 dark:text-amber-400">12 Characters</td>
              <td class="p-3.5 font-mono">3 Chars</td>
              <td class="p-3.5 font-mono">亗, 👑, ☬, ꧁༺ ༻꧂, ࿐, 么, 々, メ, ⚡, ✿</td>
              <td class="p-3.5">390 Diamonds / Name Card</td>
            </tr>
            <tr>
              <td class="p-3.5 font-semibold text-neutral-900 dark:text-white">BGMI / PUBG Mobile</td>
              <td class="p-3.5 font-mono font-bold text-sky-600 dark:text-sky-400">14 Characters</td>
              <td class="p-3.5 font-mono">3 Chars</td>
              <td class="p-3.5 font-mono">メ, 〆, 々, 么, 乡, 『 』, 【 】, 父, 气, 𓊈 𓊉</td>
              <td class="p-3.5">180 UC / Rename Card</td>
            </tr>
            <tr>
              <td class="p-3.5 font-semibold text-neutral-900 dark:text-white">Riot Valorant</td>
              <td class="p-3.5 font-mono font-bold text-emerald-600 dark:text-emerald-400">16 Characters</td>
              <td class="p-3.5 font-mono">3 Chars</td>
              <td class="p-3.5 font-mono">Small Caps (ᴋᴀᴅɪʀ), •, ·, /, —, ×, ø, †</td>
              <td class="p-3.5">Free (Every 30 Days)</td>
            </tr>
            <tr>
              <td class="p-3.5 font-semibold text-neutral-900 dark:text-white">Call of Duty: Mobile (CODM)</td>
              <td class="p-3.5 font-mono font-bold text-purple-600 dark:text-purple-400">14 Characters</td>
              <td class="p-3.5 font-mono">3 Chars</td>
              <td class="p-3.5 font-mono">☠, ⚔, ⚡, ☣, ✘, 𝕏, 🎯, ×, •, ✞</td>
              <td class="p-3.5">200 CP / 1000 Credits</td>
            </tr>
            <tr>
              <td class="p-3.5 font-semibold text-neutral-900 dark:text-white">Roblox</td>
              <td class="p-3.5 font-mono font-bold text-pink-600 dark:text-pink-400">20 Characters</td>
              <td class="p-3.5 font-mono">3 Chars</td>
              <td class="p-3.5 font-mono">✿, ♡, ✧, ⋆, 🧸, ʚɞ, ✰ (Display Name)</td>
              <td class="p-3.5">Free (Display Name) / 1000 R$</td>
            </tr>
            <tr>
              <td class="p-3.5 font-semibold text-neutral-900 dark:text-white">Minecraft Java & Bedrock</td>
              <td class="p-3.5 font-mono font-bold text-neutral-700 dark:text-neutral-300">16 Characters</td>
              <td class="p-3.5 font-mono">3 Chars</td>
              <td class="p-3.5 font-mono">Alphanumeric + Underscores (_)</td>
              <td class="p-3.5">Free (Every 30 Days)</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- Section 3 -->
    <section class="space-y-4">
      <h3 class="text-xl sm:text-2xl font-bold text-neutral-900 dark:text-white font-gaming">
        3. How Unicode Mathematical Fonts Render in UTF-8
      </h3>
      <p class="text-xs sm:text-sm leading-relaxed">
        Many gamers wonder how styled text like <span class="font-bold text-neutral-900 dark:text-white">ᴋᴀᴅɪʀ</span> or <span class="font-bold text-neutral-900 dark:text-white">𝕶𝖆𝖉𝖎𝖗</span> works in games that do not have custom font pickers. The secret lies in the **Unicode Standard (UTF-8)**.
      </p>
      <p class="text-xs sm:text-sm leading-relaxed">
        Instead of modifying the game's font files, our generator maps standard ASCII characters (A–Z) to specialized Unicode code points such as **Latin Letter Small Capitals (U+1D00–U+1D7F)**, **Mathematical Fraktur (U+1D56C–U+1D59F)**, and **Mathematical Double-Struck (U+1D538–U+1D56B)**. Because modern gaming clients support UTF-8 character encoding, they render these characters natively as universal symbols without requiring third-party keyboards.
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 pt-2">
        <div class="p-4 bg-white dark:bg-[#111620] border border-neutral-200 dark:border-[#1c2333] rounded-2xl">
          <span class="text-[10px] font-bold font-mono text-sky-500 uppercase">Small Caps</span>
          <div class="text-base font-bold font-gaming text-neutral-900 dark:text-white mt-1">ᴋ ᴀ ᴅ ɪ ʀ</div>
          <p class="text-[11px] text-neutral-500 mt-1">Clean, tournament-legal esports font widely used in Valorant and Apex Legends.</p>
        </div>
        <div class="p-4 bg-white dark:bg-[#111620] border border-neutral-200 dark:border-[#1c2333] rounded-2xl">
          <span class="text-[10px] font-bold font-mono text-amber-500 uppercase">Gothic Fraktur</span>
          <div class="text-base font-bold font-gaming text-neutral-900 dark:text-white mt-1">𝕶 𝖆 𝖉 𝖎 𝖗</div>
          <p class="text-[11px] text-neutral-500 mt-1">Dark, aggressive medieval lettering favored in Free Fire and PUBG Mobile.</p>
        </div>
        <div class="p-4 bg-white dark:bg-[#111620] border border-neutral-200 dark:border-[#1c2333] rounded-2xl">
          <span class="text-[10px] font-bold font-mono text-indigo-500 uppercase">Double Struck</span>
          <div class="text-base font-bold font-gaming text-neutral-900 dark:text-white mt-1">𝕂 𝕒 𝕕 𝕚 𝕣</div>
          <p class="text-[11px] text-neutral-500 mt-1">Modern blackboard bold font that gives IGNs a high-tech hacker look.</p>
        </div>
        <div class="p-4 bg-white dark:bg-[#111620] border border-neutral-200 dark:border-[#1c2333] rounded-2xl">
          <span class="text-[10px] font-bold font-mono text-pink-500 uppercase">Bold Script</span>
          <div class="text-base font-bold font-gaming text-neutral-900 dark:text-white mt-1">𝓚 𝓪 𝓭 𝓲 𝓻</div>
          <p class="text-[11px] text-neutral-500 mt-1">Elegant cursive calligraphy popular in Roblox and aesthetic gaming clans.</p>
        </div>
      </div>
    </section>

    <!-- Section 4 -->
    <section class="space-y-4">
      <h3 class="text-xl sm:text-2xl font-bold text-neutral-900 dark:text-white font-gaming">
        4. Cultural Symbols Breakdown: Boss Crowns, Wings & Japanese Katakana
      </h3>
      <p class="text-xs sm:text-sm leading-relaxed">
        Gaming symbols carry specific cultural meanings and status across gaming communities:
      </p>
      <ul class="space-y-3 text-xs sm:text-sm">
        <li class="p-3.5 bg-white dark:bg-[#111620] border border-neutral-200 dark:border-[#1c2333] rounded-2xl">
          <strong class="text-neutral-900 dark:text-white font-bold text-sm">Boss Crown (亗):</strong> Originally the Chinese character for "year/age" (岁), the Free Fire community transformed this glyph into the universal "Boss Crown" emblem, signifying guild leaders and top-tier fraggers.
        </li>
        <li class="p-3.5 bg-white dark:bg-[#111620] border border-neutral-200 dark:border-[#1c2333] rounded-2xl">
          <strong class="text-neutral-900 dark:text-white font-bold text-sm">Japanese Katakana (メ, 々, 么, 〆):</strong> Katakana characters like "Me" (メ) and "Iteration Mark" (々) are widely used by BGMI and PUBG Mobile pros (like Jonathan Gaming and Mortal) as stylish end-tags for clean visual balance.
        </li>
        <li class="p-3.5 bg-white dark:bg-[#111620] border border-neutral-200 dark:border-[#1c2333] rounded-2xl">
          <strong class="text-neutral-900 dark:text-white font-bold text-sm">Angel Wings (꧁༺ ༻꧂):</strong> Symmetrical ornamental wing brackets create a prestigious frame around player names in battle royale titles.
        </li>
      </ul>
    </section>

    <!-- Section 5 -->
    <section class="space-y-4">
      <h3 class="text-xl sm:text-2xl font-bold text-neutral-900 dark:text-white font-gaming">
        5. Step-by-Step: How to Change Your In-Game Name Without Missing Box (□) Errors
      </h3>
      <div class="space-y-3 text-xs sm:text-sm">
        <div class="flex items-start gap-3.5 p-4 bg-white dark:bg-[#111620] border border-neutral-200 dark:border-[#1c2333] rounded-2xl">
          <span class="w-7 h-7 rounded-xl bg-sky-600 text-white flex items-center justify-center font-bold text-xs shrink-0 shadow-sm">1</span>
          <div>
            <strong class="text-neutral-900 dark:text-white text-sm">Select & Copy:</strong> Choose your favorite synthesized nickname from our generator above and click the vibrant <strong>Copy Name</strong> button.
          </div>
        </div>
        <div class="flex items-start gap-3.5 p-4 bg-white dark:bg-[#111620] border border-neutral-200 dark:border-[#1c2333] rounded-2xl">
          <span class="w-7 h-7 rounded-xl bg-sky-600 text-white flex items-center justify-center font-bold text-xs shrink-0 shadow-sm">2</span>
          <div>
            <strong class="text-neutral-900 dark:text-white text-sm">Open Profile Banner:</strong> Launch Free Fire, BGMI, or Valorant on your mobile or PC and tap your avatar/profile icon in the top-left corner.
          </div>
        </div>
        <div class="flex items-start gap-3.5 p-4 bg-white dark:bg-[#111620] border border-neutral-200 dark:border-[#1c2333] rounded-2xl">
          <span class="w-7 h-7 rounded-xl bg-sky-600 text-white flex items-center justify-center font-bold text-xs shrink-0 shadow-sm">3</span>
          <div>
            <strong class="text-neutral-900 dark:text-white text-sm">Paste into Nickname Field:</strong> Tap the pencil/edit icon next to your nickname, long press inside the input dialog, select Paste, and verify the live character counter.
          </div>
        </div>
        <div class="flex items-start gap-3.5 p-4 bg-white dark:bg-[#111620] border border-neutral-200 dark:border-[#1c2333] rounded-2xl">
          <span class="w-7 h-7 rounded-xl bg-sky-600 text-white flex items-center justify-center font-bold text-xs shrink-0 shadow-sm">4</span>
          <div>
            <strong class="text-neutral-900 dark:text-white text-sm">Confirm with Rename Card:</strong> Use your Rename Card or in-game diamonds/UC to lock in your new alias.
          </div>
        </div>
      </div>
    </section>

    <!-- Section 6: FAQs -->
    <section class="space-y-4 pt-6 border-t border-neutral-200 dark:border-[#1c2333]">
      <h3 class="text-xl sm:text-2xl font-bold text-neutral-900 dark:text-white font-gaming">
        Frequently Asked Questions (FAQ)
      </h3>
      <FaqAccordion faqs={faqs as any} />
    </section>
  </article>
</Layout>
