---
import Layout from '@/layouts/Layout.astro';
import { GeneratorApp } from '@/islands/GeneratorApp';
import { TrendingSection } from '@/islands/TrendingSection';
import GameCard from '@/components/GameCard.astro';
import FaqAccordion from '@/components/FaqAccordion.astro';
import { getGames, getStyles, getFaqs } from '@/lib/database/repository';
import { generateWebSiteSchema, generateWebApplicationSchema, generateFaqPageSchema } from '@/lib/seo/schema';

const [games, styles, faqs] = await Promise.all([
  getGames(),
  getStyles(),
  getFaqs(),
]);

const initialGames = games.map((g) => ({
  id: g.id,
  name: g.name,
  slug: g.slug,
  logo: g.logo || '🎮',
  rules: g.rules,
}));

const initialStyles = styles.map((s) => ({
  id: s.id,
  name: s.name,
  slug: s.slug,
}));

const homeSchema = [
  generateWebSiteSchema(),
  generateWebApplicationSchema(),
  generateFaqPageSchema(faqs),
];
---

<Layout
  title="Gaming Name Generator — Stylish Nicknames & Symbols"
  description="Generate stylish, unique, and game-acceptable gaming nicknames for Free Fire, BGMI, Valorant, PUBG, and Esports Clans with verified Unicode symbols."
  schemaJson={homeSchema}
>
  <!-- Minimal Hero Header -->
  <section class="text-center pt-4 pb-8 max-w-3xl mx-auto">
    <div class="inline-flex items-center gap-1.5 px-3 py-1 mb-4 rounded-full text-xs font-medium bg-neutral-100 dark:bg-neutral-800 text-neutral-600 dark:text-neutral-300 border border-neutral-200 dark:border-neutral-700">
      <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
      <span>100% In-Game Compatible Unicode Engine</span>
    </div>

    <h1 class="text-3xl sm:text-5xl font-extrabold text-neutral-900 dark:text-white font-gaming tracking-tight mb-3">
      Gaming Name Generator
    </h1>
    <p class="text-sm sm:text-base text-neutral-500 dark:text-neutral-400 leading-relaxed max-w-xl mx-auto">
      Type any nickname or pick a style to instantly generate stylish IGNs, boss crowns, katakana, and clan tags for Free Fire, BGMI, and Valorant.
    </p>
  </section>

  <!-- Real-Time Interactive Generator Island -->
  <section class="mb-14">
    <GeneratorApp
      client:load
      initialGames={initialGames}
      initialStyles={initialStyles}
      defaultGameSlug="free-fire"
      defaultName="Kadir"
    />
  </section>

  <!-- Games Catalogue Section -->
  <section class="mb-14">
    <div class="flex items-center justify-between mb-5">
      <div>
        <h2 class="text-xl sm:text-2xl font-bold text-neutral-900 dark:text-white font-gaming">
          Game-Specific Generators
        </h2>
        <p class="text-xs text-neutral-500 dark:text-neutral-400">
          Tailored with exact character limits and supported symbols
        </p>
      </div>
      <a
        href="/games/"
        class="text-xs font-semibold text-neutral-600 dark:text-neutral-300 hover:text-neutral-900 dark:hover:text-white transition"
      >
        View All Games →
      </a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3.5">
      {games.slice(0, 8).map((game) => (
        <GameCard game={game as any} />
      ))}
    </div>
  </section>

  <!-- Live Trending Leaderboard -->
  <section class="mb-14">
    <div class="flex items-center justify-between mb-5">
      <div>
        <h2 class="text-xl sm:text-2xl font-bold text-neutral-900 dark:text-white font-gaming flex items-center gap-2">
          <span>🔥</span> Trending Nicknames
        </h2>
        <p class="text-xs text-neutral-500 dark:text-neutral-400">
          Most copied and favorited gamer tags across all games
        </p>
      </div>
      <a
        href="/trending/"
        class="text-xs font-semibold text-neutral-600 dark:text-neutral-300 hover:text-neutral-900 dark:hover:text-white transition"
      >
        Full Leaderboard →
      </a>
    </div>

    <TrendingSection client:visible />
  </section>

  <!-- Clean Informational Guide & FAQs -->
  <section class="grid grid-cols-1 lg:grid-cols-12 gap-8 pt-8 border-t border-neutral-200 dark:border-neutral-800/80">
    <div class="lg:col-span-6 space-y-4">
      <h2 class="text-xl font-bold text-neutral-900 dark:text-white font-gaming">
        How to Create a Pro Gamer Tag
      </h2>
      <div class="space-y-3 text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed">
        <p>
          In competitive multiplayer gaming (such as Garena Free Fire, BGMI, and Valorant), your in-game name (IGN) represents your identity on the kill feed and leaderboards.
        </p>
        <div class="space-y-2 pt-2">
          <div class="flex items-start gap-2">
            <span class="font-bold text-neutral-900 dark:text-white">1.</span>
            <span><strong>Keep it within length limits:</strong> Free Fire enforces a 12-character limit, while BGMI allows up to 14 characters.</span>
          </div>
          <div class="flex items-start gap-2">
            <span class="font-bold text-neutral-900 dark:text-white">2.</span>
            <span><strong>Use verified Unicode symbols:</strong> Popular symbols like boss crowns (<code class="px-1 bg-neutral-200 dark:bg-neutral-800 rounded">亗</code>), Japanese glyphs (<code class="px-1 bg-neutral-200 dark:bg-neutral-800 rounded">メ</code>, <code class="px-1 bg-neutral-200 dark:bg-neutral-800 rounded">々</code>), and angel wings (<code class="px-1 bg-neutral-200 dark:bg-neutral-800 rounded">꧁༺ ༻꧂</code>) render properly in game lobbies without showing square boxes (□).</span>
          </div>
          <div class="flex items-start gap-2">
            <span class="font-bold text-neutral-900 dark:text-white">3.</span>
            <span><strong>Esports Clan Tags:</strong> Prefix your name with clan brackets like <code class="px-1 bg-neutral-200 dark:bg-neutral-800 rounded">[SOUL]</code> or <code class="px-1 bg-neutral-200 dark:bg-neutral-800 rounded">『GODL』</code> for squad uniformity.</span>
          </div>
        </div>
      </div>
    </div>

    <div class="lg:col-span-6">
      <h2 class="text-xl font-bold text-neutral-900 dark:text-white font-gaming mb-4">
        Frequently Asked Questions
      </h2>
      <FaqAccordion faqs={faqs as any} />
    </div>
  </section>
</Layout>
