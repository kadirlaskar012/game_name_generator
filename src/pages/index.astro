---
export const prerender = true;

import Layout from '@/layouts/Layout.astro';
import { GeneratorApp } from '@/islands/GeneratorApp';
import { TrendingSection } from '@/islands/TrendingSection';
import GameCard from '@/components/GameCard.astro';
import FaqAccordion from '@/components/FaqAccordion.astro';
import AdSense from '@/components/AdSense.astro';
import { getGames, getStyles, getFaqs } from '@/lib/database/repository';
import { generateWebSiteSchema, generateWebApplicationSchema, generateFaqPageSchema } from '@/lib/seo/schema';

const [games, styles, faqs] = await Promise.all([
  getGames(),
  getStyles(),
  getFaqs(),
]);

const initialGames = games.map((g) => ({
  id: g.id,
  name: g.name,
  slug: g.slug,
  logo: g.logo || '🎮',
  rules: g.rules,
}));

const initialStyles = styles.map((s) => ({
  id: s.id,
  name: s.name,
  slug: s.slug,
}));

const homeSchema = [
  generateWebSiteSchema('https://gamertagpro.com', 'GamerTag Pro'),
  generateWebApplicationSchema(
    'GamerTag Pro — Gaming Name & Nickname Generator (2026)',
    'https://gamertagpro.com',
    'Generate stylish, unique, and game-acceptable gaming nicknames for Free Fire, BGMI, Valorant, PUBG Mobile, and Esports Clans with 32+ verified Unicode fonts and symbols.'
  ),
  generateFaqPageSchema(faqs),
];
---

<Layout
  title="Gaming Name Generator (2026) — 100% In-Game Compatible Stylish Nicknames & Symbols"
  description="Generate stylish, unique, and game-acceptable gaming nicknames for Free Fire, BGMI, Valorant, PUBG Mobile, and Esports Clans. Features Small Caps (ᴋᴀᴅɪʀ), boss crowns (亗), angel wings (꧁༺ ༻꧂), and clan brackets."
  schemaJson={homeSchema}
>
  <!-- Hero Section -->
  <section class="text-center pt-2 pb-6 max-w-2xl mx-auto">
    <div class="inline-block px-3 py-1 mb-2 rounded-full text-xs font-semibold bg-sky-100 dark:bg-sky-950/60 text-sky-700 dark:text-sky-300">
      ⚡ 100% In-Game Acceptable (32+ Styles)
    </div>

    <h1 class="text-2xl sm:text-4xl font-extrabold text-neutral-900 dark:text-white mb-2 tracking-tight">
      Gaming Name Generator
    </h1>
    <p class="text-xs sm:text-sm text-neutral-600 dark:text-neutral-400">
      Create stylish nicknames, boss crowns (亗), wings, and clan tags for Free Fire, BGMI, Valorant, and Esports.
    </p>
  </section>

  <!-- Real-Time Interactive Generator Island -->
  <section class="mb-8">
    <GeneratorApp
      client:load
      initialGames={initialGames}
      initialStyles={initialStyles}
      defaultGameSlug="free-fire"
      defaultName="BGMI"
    />
  </section>

  <!-- Responsive AdSense Placement -->
  <AdSense slot="1234567890" format="auto" />

  <!-- Games Catalogue Section -->
  <section class="mb-10 pt-6 border-t border-neutral-200 dark:border-neutral-800">
    <div class="flex items-center justify-between mb-4">
      <div>
        <h2 class="text-base sm:text-lg font-bold text-neutral-900 dark:text-white">
          Game-Specific Generators
        </h2>
        <p class="text-xs text-neutral-500">
          Tailored with exact character limits and supported symbols
        </p>
      </div>
      <a
        href="/games/"
        class="text-xs font-semibold text-sky-600 dark:text-sky-400 hover:underline"
      >
        View All →
      </a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
      {games.slice(0, 8).map((game) => (
        <GameCard game={game as any} />
      ))}
    </div>
  </section>

  <!-- Live Trending Leaderboard -->
  <section class="mb-10 pt-6 border-t border-neutral-200 dark:border-neutral-800">
    <div class="flex items-center justify-between mb-4">
      <div>
        <h2 class="text-base sm:text-lg font-bold text-neutral-900 dark:text-white">
          🔥 Trending Nicknames
        </h2>
        <p class="text-xs text-neutral-500">
          Most copied and favorited gamer tags
        </p>
      </div>
      <a
        href="/trending/"
        class="text-xs font-semibold text-sky-600 dark:text-sky-400 hover:underline"
      >
        Leaderboard →
      </a>
    </div>

    <TrendingSection client:load />
  </section>

  <!-- 1,500+ Words SEO Authority Masterclass -->
  <article class="pt-8 border-t border-neutral-200 dark:border-neutral-800 space-y-8 text-neutral-700 dark:text-neutral-300">
    <header class="space-y-2">
      <h2 class="text-xl sm:text-2xl font-bold text-neutral-900 dark:text-white">
        The Definitive Guide to Stylish Gaming Nicknames & Unicode Gamer Tags (2026)
      </h2>
      <p class="text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed">
        In modern multiplayer gaming, your in-game name (IGN) is your primary digital identity, competitive brand, and psychological signature on the kill feed. Discover how pro players craft memorable nicknames, bypass character limits safely, and combine rare Unicode symbols without getting broken question mark boxes.
      </p>
    </header>

    <!-- Table of Contents -->
    <div class="p-4 bg-neutral-50 dark:bg-[#111622] rounded-lg space-y-2">
      <h3 class="text-sm font-bold text-neutral-900 dark:text-white">
        📖 Table of Contents
      </h3>
      <ol class="grid grid-cols-1 sm:grid-cols-2 gap-1.5 text-xs text-sky-600 dark:text-sky-400 list-decimal list-inside">
        <li>The Psychology Behind Viral Gaming Nicknames</li>
        <li>Character Limits & Encoding Rules Across Top Games</li>
        <li>How Unicode Mathematical Fonts Render in UTF-8</li>
        <li>Cultural Symbols Breakdown: Boss Crowns, Wings & Katakana</li>
        <li>How to Change Your Name In-Game Without Glyph Box (□) Errors</li>
        <li>Esports Squad Tag Formats & Clan Identity Architecture</li>
        <li>Pro Player Case Studies: Mortal, Jonathan, Raistar & TenZ</li>
        <li>Frequently Asked Questions & Nickname Troubleshooting</li>
      </ol>
    </div>

    <!-- Section 1 -->
    <section class="space-y-3">
      <h3 class="text-base sm:text-lg font-bold text-neutral-900 dark:text-white">
        1. The Psychology Behind Viral Gaming Nicknames
      </h3>
      <p class="text-xs sm:text-sm leading-relaxed">
        A top-tier gaming nickname does far more than label your account—it projects psychological dominance inside the pre-match lobby and the kill feed. When enemies see a symmetrical, carefully styled alias like <strong class="text-neutral-900 dark:text-white font-mono">亗 BGMI 亗</strong> or <strong class="text-neutral-900 dark:text-white font-mono">『PUBG』メ</strong> appear repeatedly on the elimination ticker, it establishes immediate authority and tactical intimidation.
      </p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-3 pt-1">
        <div class="p-3 bg-neutral-50 dark:bg-[#111622] rounded-lg">
          <h4 class="font-bold text-neutral-900 dark:text-white text-xs mb-1">1. Comms Clarity</h4>
          <p class="text-xs text-neutral-500 dark:text-neutral-400">
            In fast-paced esports, callouts happen in milliseconds. Names with 1 to 2 syllables allow squadmates to communicate effortlessly.
          </p>
        </div>
        <div class="p-3 bg-neutral-50 dark:bg-[#111622] rounded-lg">
          <h4 class="font-bold text-neutral-900 dark:text-white text-xs mb-1">2. Kill Feed Symmetrical Framing</h4>
          <p class="text-xs text-neutral-500 dark:text-neutral-400">
            Framing symbols like wings (<code class="text-xs">꧁༺ ༻꧂</code>) and crowns (<code class="text-xs">亗</code>) draw the eye instantly.
          </p>
        </div>
        <div class="p-3 bg-neutral-50 dark:bg-[#111622] rounded-lg">
          <h4 class="font-bold text-neutral-900 dark:text-white text-xs mb-1">3. Brand Scalability</h4>
          <p class="text-xs text-neutral-500 dark:text-neutral-400">
            A great alias transitions seamlessly to YouTube Gaming channels, Discord servers, and tournament rosters.
          </p>
        </div>
      </div>
    </section>

    <!-- Section 2 -->
    <section class="space-y-3">
      <h3 class="text-base sm:text-lg font-bold text-neutral-900 dark:text-white">
        2. In-Game Character Limits & Encoding Rules Across Top Games (2026)
      </h3>
      <p class="text-xs sm:text-sm leading-relaxed">
        Game engines process player names through different text sanitizers. Exceeding these limits causes the game client to reject the Rename Card.
      </p>

      <div class="overflow-x-auto border border-neutral-200 dark:border-neutral-800 rounded-lg">
        <table class="w-full text-left text-xs">
          <thead class="bg-neutral-100 dark:bg-[#111622] border-b border-neutral-200 dark:border-neutral-800 text-neutral-900 dark:text-white">
            <tr>
              <th class="p-2.5 font-bold">Game Title</th>
              <th class="p-2.5 font-bold">Max Limit</th>
              <th class="p-2.5 font-bold">Min Limit</th>
              <th class="p-2.5 font-bold">Supported Symbols</th>
              <th class="p-2.5 font-bold">Rename Cost</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-neutral-200 dark:divide-neutral-800 text-neutral-600 dark:text-neutral-400">
            <tr>
              <td class="p-2.5 font-semibold text-neutral-900 dark:text-white">Garena Free Fire / MAX</td>
              <td class="p-2.5 font-mono font-bold text-amber-600">12 Chars</td>
              <td class="p-2.5 font-mono">3</td>
              <td class="p-2.5 font-mono">亗, 👑, ☬, ꧁༺ ༻꧂, ࿐, 么, 々, メ</td>
              <td class="p-2.5">390 Diamonds</td>
            </tr>
            <tr>
              <td class="p-2.5 font-semibold text-neutral-900 dark:text-white">BGMI / PUBG Mobile</td>
              <td class="p-2.5 font-mono font-bold text-sky-600">14 Chars</td>
              <td class="p-2.5 font-mono">3</td>
              <td class="p-2.5 font-mono">メ, 〆, 々, 么, 乡, 『 』, 【 】, 𓊈 𓊉</td>
              <td class="p-2.5">180 UC</td>
            </tr>
            <tr>
              <td class="p-2.5 font-semibold text-neutral-900 dark:text-white">Riot Valorant</td>
              <td class="p-2.5 font-mono font-bold text-emerald-600">16 Chars</td>
              <td class="p-2.5 font-mono">3</td>
              <td class="p-2.5 font-mono">Small Caps (ʙɢᴍɪ), •, ·, /, —, ×</td>
              <td class="p-2.5">Free (Every 30 Days)</td>
            </tr>
            <tr>
              <td class="p-2.5 font-semibold text-neutral-900 dark:text-white">Call of Duty: Mobile (CODM)</td>
              <td class="p-2.5 font-mono font-bold text-purple-600">14 Chars</td>
              <td class="p-2.5 font-mono">3</td>
              <td class="p-2.5 font-mono">☠, ⚔, ⚡, ☣, ✘, 𝕏, 🎯, ×, •</td>
              <td class="p-2.5">200 CP / 1000 Credits</td>
            </tr>
            <tr>
              <td class="p-2.5 font-semibold text-neutral-900 dark:text-white">Roblox</td>
              <td class="p-2.5 font-mono font-bold text-pink-600">20 Chars</td>
              <td class="p-2.5 font-mono">3</td>
              <td class="p-2.5 font-mono">✿, ♡, ✧, ⋆, 🧸, ʚɞ, ✰</td>
              <td class="p-2.5">Free (Display Name)</td>
            </tr>
            <tr>
              <td class="p-2.5 font-semibold text-neutral-900 dark:text-white">Minecraft</td>
              <td class="p-2.5 font-mono font-bold text-neutral-700 dark:text-neutral-300">16 Chars</td>
              <td class="p-2.5 font-mono">3</td>
              <td class="p-2.5 font-mono">Alphanumeric + _</td>
              <td class="p-2.5">Free (Every 30 Days)</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- Section 3 -->
    <section class="space-y-3">
      <h3 class="text-base sm:text-lg font-bold text-neutral-900 dark:text-white">
        3. How Unicode Mathematical Fonts Render in UTF-8
      </h3>
      <p class="text-xs sm:text-sm leading-relaxed">
        Instead of modifying the game's font files, our generator maps standard ASCII characters (A–Z) to specialized Unicode code points such as **Latin Letter Small Capitals (U+1D00–U+1D7F)** and **Mathematical Fraktur (U+1D56C–U+1D59F)**. Modern gaming clients support UTF-8 character encoding and render these characters natively.
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-2.5 pt-1">
        <div class="p-3 bg-neutral-50 dark:bg-[#111622] rounded-lg">
          <span class="text-[10px] font-bold text-sky-500 uppercase">Small Caps</span>
          <div class="text-sm font-bold text-neutral-900 dark:text-white mt-0.5">ʙ ɢ ᴍ ɪ</div>
        </div>
        <div class="p-3 bg-neutral-50 dark:bg-[#111622] rounded-lg">
          <span class="text-[10px] font-bold text-amber-500 uppercase">Gothic Fraktur</span>
          <div class="text-sm font-bold text-neutral-900 dark:text-white mt-0.5">𝕭 𝕲 𝕸 𝕴</div>
        </div>
        <div class="p-3 bg-neutral-50 dark:bg-[#111622] rounded-lg">
          <span class="text-[10px] font-bold text-indigo-500 uppercase">Double Struck</span>
          <div class="text-sm font-bold text-neutral-900 dark:text-white mt-0.5">𝔹 𝔾 𝕄 𝕀</div>
        </div>
        <div class="p-3 bg-neutral-50 dark:bg-[#111622] rounded-lg">
          <span class="text-[10px] font-bold text-pink-500 uppercase">Bold Script</span>
          <div class="text-sm font-bold text-neutral-900 dark:text-white mt-0.5">𝓑 𝓖 𝓜 𝓘</div>
        </div>
      </div>
    </section>

    <!-- Section 4 -->
    <section class="space-y-3">
      <h3 class="text-base sm:text-lg font-bold text-neutral-900 dark:text-white">
        4. Cultural Symbols Breakdown
      </h3>
      <ul class="space-y-2 text-xs sm:text-sm">
        <li class="p-2.5 bg-neutral-50 dark:bg-[#111622] rounded-lg">
          <strong class="text-neutral-900 dark:text-white">Boss Crown (亗):</strong> Originally Chinese for year/age (岁), transformed by the Free Fire community into the universal Boss Crown.
        </li>
        <li class="p-2.5 bg-neutral-50 dark:bg-[#111622] rounded-lg">
          <strong class="text-neutral-900 dark:text-white">Japanese Katakana (メ, 々, 么, 〆):</strong> Katakana characters used by BGMI/PUBG Mobile pros as stylish end-tags.
        </li>
        <li class="p-2.5 bg-neutral-50 dark:bg-[#111622] rounded-lg">
          <strong class="text-neutral-900 dark:text-white">Angel Wings (꧁༺ ༻꧂):</strong> Symmetrical ornamental wing brackets that frame player names.
        </li>
      </ul>
    </section>

    <!-- Section 5 -->
    <section class="space-y-3">
      <h3 class="text-base sm:text-lg font-bold text-neutral-900 dark:text-white">
        5. How to Change Your Name In-Game
      </h3>
      <div class="space-y-2 text-xs sm:text-sm">
        <div class="p-2.5 bg-neutral-50 dark:bg-[#111622] rounded-lg">
          <strong>1. Select & Copy:</strong> Click the Copy button next to any name above.
        </div>
        <div class="p-2.5 bg-neutral-50 dark:bg-[#111622] rounded-lg">
          <strong>2. Open Profile:</strong> Launch your game and tap your avatar/profile icon.
        </div>
        <div class="p-2.5 bg-neutral-50 dark:bg-[#111622] rounded-lg">
          <strong>3. Paste & Save:</strong> Tap edit name, paste your new nickname, and confirm with your Rename Card.
        </div>
      </div>
    </section>

    <!-- Section 6: FAQs -->
    <section class="space-y-3 pt-4 border-t border-neutral-200 dark:border-neutral-800">
      <h3 class="text-base sm:text-lg font-bold text-neutral-900 dark:text-white">
        Frequently Asked Questions
      </h3>
      <FaqAccordion faqs={faqs as any} />
    </section>
  </article>
</Layout>
