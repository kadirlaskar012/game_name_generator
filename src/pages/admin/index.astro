---
import AdminLayout from '@/layouts/AdminLayout.astro';
import { AdminDashboard } from '@/islands/AdminDashboard';
import { validateAdminSession } from '@/lib/security/auth';

const auth = await validateAdminSession(Astro.request);

// If not authenticated, redirect server-side to login
if (!auth.isAuthenticated) {
  return Astro.redirect('/admin/login');
}
---

<AdminLayout title="Platform Control Center">
  <AdminDashboard client:load />
</AdminLayout>
