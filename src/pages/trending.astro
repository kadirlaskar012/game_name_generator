---
import Layout from '@/layouts/Layout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { TrendingSection } from '@/islands/TrendingSection';
import { generateBreadcrumbSchema } from '@/lib/seo/schema';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Trending Names', url: '/trending/' },
];

const schema = [
  generateBreadcrumbSchema(breadcrumbs),
];
---

<Layout
  title="Trending Gaming Names & Nicknames — Live Leaderboard"
  description="Discover the most popular, copied, and favorited gamer tags in real time, dynamically ranked by player popularity."
  schemaJson={schema}
>
  <Breadcrumbs items={breadcrumbs} />

  <div class="mb-8">
    <h1 class="text-2xl sm:text-4xl font-extrabold text-neutral-900 dark:text-white font-gaming mb-2 flex items-center gap-2">
      <span>🔥</span> Live Trending Leaderboard
    </h1>
    <p class="text-xs sm:text-sm text-neutral-500 dark:text-neutral-400 max-w-xl">
      The most popular in-game names copied and favorited by the community. Click Copy or Download Card on any item.
    </p>
  </div>

  <section class="mb-12">
    <TrendingSection client:load />
  </section>
</Layout>
