---
export interface BreadcrumbItem {
  name: string;
  url: string;
}

export interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="py-3 text-xs font-mono">
  <ol class="flex items-center flex-wrap gap-1.5 text-gray-400">
    <li>
      <a href="/" class="hover:text-gaming-accent transition flex items-center gap-1">
        <span>🏠</span> Home
      </a>
    </li>
    {items.map((item, index) => {
      const isLast = index === items.length - 1;
      return (
        <li class="flex items-center gap-1.5">
          <span class="text-gray-600">/</span>
          {isLast ? (
            <span class="text-gaming-accent font-semibold truncate max-w-[200px] sm:max-w-none" aria-current="page">
              {item.name}
            </span>
          ) : (
            <a href={item.url} class="hover:text-white transition truncate max-w-[160px] sm:max-w-none">
              {item.name}
            </a>
          )}
        </li>
      );
    })}
  </ol>
</nav>
