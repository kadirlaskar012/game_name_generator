---
export interface Props {
  slot?: string;
  client?: string;
  format?: 'auto' | 'fluid' | 'rectangle' | 'horizontal';
  responsive?: boolean;
  className?: string;
  label?: string;
}

const {
  slot = '1234567890',
  client = 'ca-pub-XXXXXXXXXXXXXXXX',
  format = 'auto',
  responsive = true,
  className = '',
  label = 'Advertisement',
} = Astro.props;

const isProduction = import.meta.env.PROD && client !== 'ca-pub-XXXXXXXXXXXXXXXX';
---

<div class={`adsense-container my-6 text-center ${className}`}>
  <div class="text-[10px] tracking-wider uppercase font-semibold text-neutral-400 dark:text-neutral-500 mb-1">
    {label}
  </div>

  {isProduction ? (
    <ins
      class="adsbygoogle"
      style="display:block"
      data-ad-client={client}
      data-ad-slot={slot}
      data-ad-format={format}
      data-full-width-responsive={responsive ? 'true' : 'false'}
    />
  ) : (
    <!-- AdSense Placeholder for Review and Ad Placement Alignment -->
    <div class="w-full min-h-[90px] sm:min-h-[100px] max-w-4xl mx-auto bg-neutral-50 dark:bg-[#111622] border border-dashed border-neutral-300 dark:border-neutral-800 rounded-lg flex flex-col items-center justify-center p-4 transition-colors">
      <div class="flex items-center gap-2 text-xs font-semibold text-neutral-500 dark:text-neutral-400">
        <span class="px-2 py-0.5 rounded bg-neutral-200 dark:bg-neutral-800 text-[10px] font-mono font-bold text-neutral-700 dark:text-neutral-300">
          AdSense Slot #{slot}
        </span>
        <span>• Responsive Display Unit ({format})</span>
      </div>
      <p class="text-[11px] text-neutral-400 dark:text-neutral-500 mt-1">
        Replace <code class="font-mono text-sky-500">ca-pub-XXXXXXXXXXXXXXXX</code> with your approved Google AdSense Publisher ID in production.
      </p>
    </div>
  )}
</div>

<script is:inline>
  if (typeof window !== 'undefined' && window.adsbygoogle) {
    try {
      (window.adsbygoogle = window.adsbygoogle || []).push({});
    } catch (e) {}
  }
</script>
