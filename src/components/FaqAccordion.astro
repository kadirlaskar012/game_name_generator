---
import type { SeedFaq } from '@/lib/database/seedData';

export interface Props {
  faqs: SeedFaq[];
}

const { faqs } = Astro.props;
---

<div class="space-y-3">
  {faqs.map((faq, index) => (
    <details
      class="group glass-panel rounded-2xl p-4 sm:p-5 transition-all"
      open={index === 0}
    >
      <summary class="flex items-center justify-between font-bold text-neutral-900 dark:text-white text-sm sm:text-base cursor-pointer select-none list-none">
        <span class="pr-4">{faq.question}</span>
        <span class="w-6 h-6 rounded-full bg-sky-50 dark:bg-white/5 border border-sky-200/50 dark:border-white/10 flex items-center justify-center text-sky-600 dark:text-sky-400 group-open:rotate-180 transition-transform shrink-0 font-mono text-[10px]">
          ▼
        </span>
      </summary>
      <div class="mt-3 pt-3 border-t border-neutral-200/40 dark:border-white/5 text-xs sm:text-sm text-neutral-600 dark:text-neutral-300 leading-relaxed">
        {faq.answer}
      </div>
    </details>
  ))}
</div>
