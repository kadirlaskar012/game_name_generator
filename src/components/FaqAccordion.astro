---
import type { SeedFaq } from '@/lib/database/seedData';

export interface Props {
  faqs: SeedFaq[];
}

const { faqs } = Astro.props;
---

<div class="divide-y divide-neutral-200 dark:divide-neutral-800">
  {faqs.map((faq, index) => (
    <details
      class="group py-3 transition-colors"
      open={index === 0}
    >
      <summary class="flex items-center justify-between font-semibold text-neutral-900 dark:text-white text-sm sm:text-base cursor-pointer select-none list-none">
        <span class="pr-4">{faq.question}</span>
        <span class="text-neutral-400 group-open:rotate-180 transition-transform shrink-0 font-mono text-xs">
          ▼
        </span>
      </summary>
      <div class="mt-2 text-xs sm:text-sm text-neutral-600 dark:text-neutral-300 leading-relaxed pl-1">
        {faq.answer}
      </div>
    </details>
  ))}
</div>
