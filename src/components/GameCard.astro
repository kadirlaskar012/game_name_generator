---
import type { SeedGame } from '@/lib/database/seedData';

export interface Props {
  game: SeedGame;
}

const { game } = Astro.props;
---

<a
  href={`/${game.slug}-name-generator/`}
  class="group glass-panel rounded-3xl p-5 sm:p-6 transition-all duration-200 hover:-translate-y-1 hover:shadow-xl hover:shadow-sky-500/10 flex flex-col justify-between"
>
  <div>
    <div class="flex items-center justify-between mb-3">
      <div class="w-11 h-11 rounded-2xl bg-gradient-to-tr from-sky-500/15 to-indigo-500/15 border border-sky-500/20 flex items-center justify-center text-2xl group-hover:scale-110 transition-transform">
        {game.logo}
      </div>
      <span class="text-[10px] font-mono font-bold px-2.5 py-1 rounded-full bg-sky-50 dark:bg-sky-950/40 text-sky-600 dark:text-sky-400 border border-sky-200/50 dark:border-sky-900/30">
        Max {game.rules?.maxLength || 14} Chars
      </span>
    </div>

    <h3 class="text-base sm:text-lg font-bold text-neutral-900 dark:text-white font-gaming mb-1.5 group-hover:text-sky-500 transition-colors">
      {game.name}
    </h3>
    <p class="text-xs text-neutral-500 dark:text-neutral-400 line-clamp-2 leading-relaxed mb-4">
      {game.description}
    </p>
  </div>

  <div class="flex items-center justify-between pt-3 border-t border-neutral-200/40 dark:border-white/5 text-xs font-bold text-sky-600 dark:text-sky-400">
    <span>Launch Generator →</span>
    <div class="flex items-center gap-1.5 text-xs font-mono opacity-80">
      {game.rules?.preferredSymbols?.slice(0, 4).map((s) => (
        <span class="bg-neutral-100 dark:bg-white/5 px-1.5 py-0.5 rounded-md">{s}</span>
      ))}
    </div>
  </div>
</a>
