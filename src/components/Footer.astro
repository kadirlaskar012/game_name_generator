---
import { SEED_GAMES } from '@/lib/database/seedData';
---

<footer class="border-t border-neutral-200 dark:border-neutral-800/80 bg-white dark:bg-[#0b0f19] py-10 transition-colors">
  <div class="max-w-5xl mx-auto px-4 sm:px-6">
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-8 mb-8 text-xs">
      <!-- Brand column -->
      <div>
        <a href="/" class="flex items-center gap-2 mb-2 font-gaming font-extrabold text-base text-neutral-900 dark:text-white">
          🎮 GAMERTAG<span class="text-sky-500">PRO</span>
        </a>
        <p class="text-neutral-500 dark:text-neutral-400 leading-relaxed mb-3">
          Ultra-fast Unicode gaming nickname generator for Free Fire, BGMI, Valorant, esports squads, and pets.
        </p>
      </div>

      <!-- Games Column -->
      <div>
        <h4 class="font-semibold text-neutral-900 dark:text-neutral-200 mb-2 uppercase tracking-wider text-[11px]">
          Game Generators
        </h4>
        <ul class="space-y-1.5 text-neutral-500 dark:text-neutral-400">
          {SEED_GAMES.slice(0, 6).map((game) => (
            <li>
              <a
                href={`/${game.slug}-name-generator/`}
                class="hover:text-sky-500 transition flex items-center gap-1.5"
              >
                <span>{game.logo}</span> {game.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Specialized Tools Column -->
      <div>
        <h4 class="font-semibold text-neutral-900 dark:text-neutral-200 mb-2 uppercase tracking-wider text-[11px]">
          Specialized Tools
        </h4>
        <ul class="space-y-1.5 text-neutral-500 dark:text-neutral-400">
          <li><a href="/name-battle/" class="hover:text-rose-500 transition font-medium text-rose-500">⚔️ Daily Name Battle</a></li>
          <li><a href="/pet-name-generator/" class="hover:text-sky-500 transition">🐾 Pet Name Generator</a></li>
          <li><a href="/multilingual-name-generator/" class="hover:text-sky-500 transition">🌐 Multi-Language Names</a></li>
          <li><a href="/clan-name-generator/" class="hover:text-sky-500 transition">🛡️ Clan & Guild Tags</a></li>
          <li><a href="/esports-name-generator/" class="hover:text-sky-500 transition">🏆 Esports Pro Names</a></li>
          <li><a href="/games/" class="hover:text-sky-500 transition">🎮 All Games Directory</a></li>
        </ul>
      </div>

      <!-- Quick Links -->
      <div>
        <h4 class="font-semibold text-neutral-900 dark:text-neutral-200 mb-2 uppercase tracking-wider text-[11px]">
          Platform & Trends
        </h4>
        <ul class="space-y-1.5 text-neutral-500 dark:text-neutral-400">
          <li><a href="/trending/" class="hover:text-amber-500 transition font-bold text-amber-500">🔥 Trending Leaderboard</a></li>
          <li><a href="/favorites/" class="hover:text-red-500 transition">❤️ Saved Favorites</a></li>
          <li><a href="/sitemap.xml" class="hover:text-sky-500 transition">📄 XML Sitemap</a></li>
          <li><a href="/robots.txt" class="hover:text-sky-500 transition">🤖 Robots.txt</a></li>
        </ul>
      </div>
    </div>

    <div class="pt-6 border-t border-neutral-200 dark:border-neutral-800/80 flex flex-col sm:flex-row items-center justify-between gap-3 text-[11px] text-neutral-400">
      <div>
        &copy; {new Date().getFullYear()} GamerTag Pro. 100% Client & Server Unicode Compliant.
      </div>
      <div class="text-neutral-500">
        PWA Enabled • Fast Global Edge CDN
      </div>
    </div>
  </div>
</footer>
